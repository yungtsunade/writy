{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Writy",
  "version": "0.1.1",
  "identifier": "com.yungtsunade.writy",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Writy",
        "width": 1200,
        "height": 820,
        "minWidth": 480,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Kleine Schreib-App im 8-Bit-Look",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"]
      }
    }
  }
}
